--- !u!114 &791609563
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 791609561}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f0bfee48b21b0bf4aa48877f623aec48, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  prompt: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0435"
  title: "\u0420\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0438.
    \u0425\u0438\u0440\u0443\u0440\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435."
  text: "     \u041F\u0440\u0430\u043A\u0442\u0438\u043A\u0430\u043D\u0442 \u21161
    \u2014 \u041C\u0430\u0440\u0438\u043D\u0430 \u0412.\u0421. \u2014 \u0434\u043D\u0435\u0432\u043D\u0430\u044F
    \u0441\u043C\u0435\u043D\u0430, 10 \u0434\u0435\u043A\u0430\u0431\u0440\u044F\r\n    
    \u041F\u0440\u0430\u043A\u0442\u0438\u043A\u0430\u043D\u0442 \u21162 \u2014 \u0413\u0440\u043E\u043C\u043E\u0432
    \u0410.\u041F. \u2014 \u0434\u043D\u0435\u0432\u043D\u0430\u044F + \u043D\u043E\u0447\u043D\u0430\u044F
    \u0441\u043C\u0435\u043D\u044B, 6 \u0434\u0435\u043A\u0430\u0431\u0440\u044F\r\n    
    \u041F\u0440\u0430\u043A\u0442\u0438\u043A\u0430\u043D\u0442 \u21163 \u2014 \u041A\u043E\u0432\u0430\u043B\u0451\u0432
    \u0414.\u0418. \u2014 \u0434\u043D\u0435\u0432\u043D\u0430\u044F \u0441\u043C\u0435\u043D\u0430,
    11 \u0434\u0435\u043A\u0430\u0431\u0440\u044F\r\n     \u041F\u0440\u0430\u043A\u0442\u0438\u043A\u0430\u043D\u0442
    \u21164 \u2014 \u043D\u043E\u0447\u043D\u0430\u044F \u0441\u043C\u0435\u043D\u0430,
    13 \u0434\u0435\u043A\u0430\u0431\u0440\u044F (\u043F\u0435\u0440\u0432\u0430\u044F)\r\n\r\n    
    \u0414\u043D\u0435\u0432\u043D\u0430\u044F \u0441\u043C\u0435\u043D\u0430: \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u043A\u0438,
    \u0430\u043D\u0430\u043B\u0438\u0437\u044B \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044E,
    \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u0435 \u0436\u0443\u0440\u043D\u0430\u043B\u043E\u0432.\r\n    
    \u041D\u043E\u0447\u043D\u0430\u044F \u0441\u043C\u0435\u043D\u0430: \u043A\u0430\u0436\u0434\u044B\u0435
    2 \u0447\u0430\u0441\u0430 \u2014 \u043E\u0431\u0445\u043E\u0434 \u043F\u0430\u043B\u0430\u0442
    2 \u044D\u0442\u0430\u0436\u0430 \u043F\u043E \u0441\u043F\u0438\u0441\u043A\u0443
    \u043E\u0431\u0445\u043E\u0434\u0430.\r\n     \u0421\u043F\u0438\u0441\u043E\u043A
    \u043E\u0431\u0445\u043E\u0434\u0430 \u2014 \u0443 \u0441\u0442\u0430\u0440\u0448\u0435\u0439
    \u043C\u0435\u0434\u0441\u0435\u0441\u0442\u0440\u044B."
  image: {fileID: 0}
  takeAfterReading: 0
  onFirstRead:
    m_PersistentCalls:
      m_Calls: []
  onAfterClose:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 302184135}
        m_TargetAssemblyTypeName: GameManager, Assembly-CSharp
        m_MethodName: Say
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: "\u0421\u043F\u0438\u0441\u043A\u0430 \u043E\u0431\u0445\u043E\u0434\u0430
            \u0442\u0443\u0442 \u043D\u0435\u0442... \u041D\u0430\u0434\u043E \u0435\u0433\u043E
            \u043D\u0430\u0439\u0442\u0438. \u041C\u043E\u0436\u0435\u0442, \u043E\u0441\u0442\u0430\u043B\u0441\u044F
            \u0432 \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u043F\u0430\u043B\u0430\u0442."
          m_BoolArgument: 0
        m_CallState: 2
      - m_Target: {fileID: 702764092}
