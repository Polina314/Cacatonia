    \u044D\u0432\u0430\u043A\u0443\u0430\u0446\u0438\u0438"
  text: "\u0421\u0442\u0430\u0440\u044B\u0439, \u043F\u043E\u0436\u0435\u043B\u0442\u0435\u0432\u0448\u0438\u0439.
