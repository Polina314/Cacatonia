  title: "\u0416\u0443\u0440\u043D\u0430\u043B \u0434\u0435\u0436\u0443\u0440\u043D\u043E\u0439
    \u043C\u0435\u0434\u0441\u0435\u0441\u0442\u0440\u044B"
  text: "     02:40 \u2014 \u0432\u0441\u0451 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E,
    \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u044B \u0441\u043F\u044F\u0442.\r\n    
    03:00 \u2014 \u043E\u043F\u044F\u0442\u044C \u0437\u0432\u043E\u043D\u0438\u043B
    \u0442\u0435\u043B\u0435\u0444\u043E\u043D, \u0432 \u0442\u0440\u0443\u0431\u043A\u0435
    \u0442\u0438\u0448\u0438\u043D\u0430.\r\n     03:13 \u2014 \u0443\u0448\u043B\u0430
    \u043D\u0430 \u043E\u0431\u0445\u043E\u0434 2 \u044D\u0442\u0430\u0436\u0430."
